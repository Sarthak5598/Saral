# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
APP_ROUTE_PREFIX=/api/v1

LOG_LEVEL=debug
# "dev" = pretty-printed for humans, "json" = one JSON object per line
LOG_OUTPUT=dev

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Docker Compose publishes Postgres on 5434 to avoid clashing with a Postgres
# already running on the host (5432 and 5433 are both commonly taken). Swapping
# this single value for an RDS endpoint is the only change needed to move off
# Docker - no code changes.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/hashtag_media
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Meta Graph API
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=replace-me
META_IG_USER_ID=17841480695597364
META_GRAPH_VERSION=v24.0
META_API_BASE_URL=https://graph.facebook.com

# ---------------------------------------------------------------------------
# Ingestion tuning
# ---------------------------------------------------------------------------
# Hard cap on media pulled per sync run, per the assignment brief.
SYNC_MAX_MEDIA_PER_RUN=500
# Starting page size. Meta documents 50 as the max but rejects far smaller pages
# in practice - measured against v24.0, top_media refused 10 and recent_media
# refused 25, returning HTTP 500 with Graph error code 1. The client negotiates
# this value down automatically until Meta accepts it, so treat it as an upper
# bound rather than a setting that has to be correct.
SYNC_PAGE_SIZE=25
# Parallel asset downloads. Higher = faster, but more memory and more chance of
# Meta CDN throttling.
DOWNLOAD_CONCURRENCY=5
# Back off when Meta reports this much of the rate-limit budget consumed.
META_THROTTLE_THRESHOLD_PCT=80
# The hashtag edges are slow - ~8s per page measured against v24.0.
META_REQUEST_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Driver selection: "local" or "aws"
# ---------------------------------------------------------------------------
# These are independent on purpose - you can run S3 storage with an in-memory
# queue, or SQS with local disk storage, while migrating piece by piece.
QUEUE_DRIVER=local
STORAGE_DRIVER=local
SCHEDULER_DRIVER=local

# --- local driver settings ---
LOCAL_STORAGE_DIR=./storage
# Only used when SCHEDULER_DRIVER=local. Ignored under AWS, where EventBridge
# Scheduler owns the cron expression instead.
RECENT_SYNC_CRON=0 */3 * * *

# --- aws driver settings ---
AWS_REGION=eu-west-2
S3_BUCKET=
SQS_QUEUE_URL=
SQS_DLQ_URL=
# Seconds. Must exceed the worst-case processing time for one job or SQS will
# redeliver a message that is still being worked on.
SQS_VISIBILITY_TIMEOUT=300
SQS_WAIT_TIME_SECONDS=20
EVENTBRIDGE_SCHEDULE_NAME=sync-recent-hashtag-media
EVENTBRIDGE_SCHEDULE_ROLE_ARN=
