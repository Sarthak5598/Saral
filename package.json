{
  "name": "hashtag-media-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable ingestion pipeline for Instagram hashtag media (Meta Graph API -> Postgres + object storage)",
  "main": "src/app.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx commands/seed.ts",
    "db:studio": "drizzle-kit studio",
    "hashtag:track": "tsx commands/trackHashtag.ts",
    "hashtag:untrack": "tsx commands/untrackHashtag.ts",
    "sync:top": "tsx commands/syncTop.ts",
    "sync:recent": "tsx commands/syncRecent.ts",
    "replay": "tsx commands/replay.ts",
    "aws:provision": "tsx commands/provisionAws.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "aws:teardown": "tsx commands/teardownAws.ts"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-scheduler": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-sts": "^3.1111.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "p-limit": "^6.2.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "drizzle-kit": "^0.30.1",
    "eslint": "^8.57.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
